    <!-- Trust interface -->
    <string name="trust_category_features">Status</string>
    <string name="trust_feature_selinux">SELinux</string>
    <string name="trust_feature_selinux_value_enforcing">Enforcing</string>
    <string name="trust_feature_selinux_value_disabled">Desativado</string>
    <string name="trust_feature_selinux_explain">O SELinux determina quais processos têm acesso a quais arquivos/caminhos em seu dispositivo.\nIsso evita que apps e serviços acessem arquivos que não deveriam: dessa forma, um processo potencialmente malicioso é limitado e sua segurança é preservada.</string>
    <string name="trust_feature_security_patches">Patches de segurança do Android</string>
    <string name="trust_feature_security_patches_value_base">Plataforma: %1$s\nFornecedor: %2$s</string>
    <string name="trust_feature_security_patches_value_new">Atualizado</string>
    <string name="trust_feature_security_patches_value_medium">Desatualizado há alguns meses</string>
    <string name="trust_feature_security_patches_value_old">Desatualizado</string>
    <string name="trust_feature_security_patches_explain">Patches de segurança são lançados mensalmente pelo Google em cooperação com fornecedores de SoC para solucionar falhas que podem ser exploradas por apps maliciosos para contornar restrições de segurança e causar danos permanentes ao seu dispositivo. Os patches disponibilizados pelo Google são aplicados mensalmente em todos os dispositivos compatíveis, mas os patches para código proprietário só podem ser aplicados pelo fabricante do seu dispositivo. Para manter seu dispositivo seguro, certifique-se de que sua versão da Evolution X esteja sempre atualizada e (se aplicável) certifique-se de que a imagem do seu fornecedor esteja atualizada para a mais recente recomendada pela Evolution X.</string>
    <string name="trust_feature_encryption">Criptografia</string>
    <string name="trust_feature_encryption_value_enabled">Ativada</string>
    <string name="trust_feature_encryption_value_nolock">Precisa de uma tela de bloqueio segura</string>
    <string name="trust_feature_encryption_value_disabled">Desativada</string>
    <string name="trust_feature_encryption_explain">Criptografar seu dispositivo impede o acesso aos seus dados quando o telefone não é inicializado no Android. Isso é especialmente importante se o seu telefone for roubado, pois evita que as pessoas leiam suas mensagens, contatos e outras informações privadas sem sua senha.\nPara tornar a criptografia mais eficaz, você precisa definir uma senha segura para a tela de bloqueio.</string>
    <string name="trust_category_tools">Privacidade</string>
    <string name="trust_notification_alerts_title">Alertas de segurança</string>
    <string name="trust_warnings_alerts_intro">Você pode selecionar os problemas de segurança sobre os quais deseja ser avisado. Para sua segurança, é recomendado ativar todos os alertas</string>
    <string name="trust_warnings_selinux">Status do SELinux</string>
