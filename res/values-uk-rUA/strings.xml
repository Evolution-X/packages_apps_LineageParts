    <!-- Trust interface -->
    <string name="trust_category_features">Статус</string>
    <string name="trust_feature_selinux">SELinux</string>
    <string name="trust_feature_selinux_value_enforcing">Примусовий</string>
    <string name="trust_feature_selinux_value_disabled">Вимкнено</string>
    <string name="trust_feature_selinux_explain">SELinux визначає, які процеси мають доступ до файлів на вашому пристрої.\nЦе запобігає доступу додатків і сервісів до файлів, з якими вони не повинні мати справу: таким чином, шкідливий процес має обмежений доступ, щоб ваша безпека була збережена.</string>
    <string name="trust_feature_security_patches">Патч безпеки Android</string>
    <string name="trust_feature_security_patches_value_base">Платформа: %1$s\nВиробник: %2$s</string>
    <string name="trust_feature_security_patches_value_new">Остання версія</string>
    <string name="trust_feature_security_patches_value_medium">Застаріло на кілька місяців</string>
    <string name="trust_feature_security_patches_value_old">Потребує оновлення</string>
    <string name="trust_feature_security_patches_explain">Пакунки безпеки щомісяця публікуються компанією Google у співпраці з постачальниками SoC для вирішення недоліків, які можуть бути використані шкідливими додатками для обходу обмежень безпеки та заподіяння постійного збитку вашому пристрою. Патчі, надані компанією Google, застосовуються щомісяця на всіх підтримуваних пристроях, однак патчі до власного коду можуть застосовуватися лише виробником вашого пристрою. Щоб забезпечити безпеку вашого пристрою, переконайтеся, що ваш збірка LineageOS завжди є найновішою, і, якщо це доцільно, переконайтеся, що ваша збірка оновлена до останньої, рекомендованої LineageOS.</string>
    <string name="trust_feature_encryption">Шифрування</string>
    <string name="trust_feature_encryption_value_enabled">Увімкнено</string>
    <string name="trust_feature_encryption_value_nolock">Потребує безпечного екрану блокування</string>
    <string name="trust_feature_encryption_value_disabled">Вимкнено</string>
    <string name="trust_feature_encryption_explain">Шифрування вашого пристрою запобігає доступу до ваших даних, коли ваш телефон вимкнено або він перебуває у режимі відновлення. Це особливо важливо якщо ваш телефон було вкрадено і запобігає доступу сторонніх осіб до ваших повідомлень, контактів та іншої приватної інформації без паролю.\nЩоб зробити шифрування більш ефективним ви маєте встановити захист екрану блокування.</string>
    <string name="trust_category_tools">Конфіденційність</string>
